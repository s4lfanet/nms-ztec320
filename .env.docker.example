# Salfanet NMS — Docker Compose environment.
# Copy to .env.docker and fill in real values:
#   cp .env.docker.example .env.docker

# REQUIRED — Flask sessions. Generate: openssl rand -hex 32
SECRET_KEY=change-me

# REQUIRED in production — internal Flask→FastAPI key. Different from SECRET_KEY.
INTERNAL_API_KEY=change-me-too

# Postgres password (matches POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=nms

# External HTTP port exposed by nginx (container listens on 80 inside).
HTTP_PORT=8080

FLASK_ENV=production
# TZ=Asia/Jakarta
