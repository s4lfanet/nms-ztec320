# Logs
*.log
backend.log
backend-err.log
frontend.log
frontend-err.log

# Debug screenshots
*.png
!frontend/public/pwa/*.png

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Node
frontend/node_modules/
node_modules/
# frontend/dist/ is intentionally committed — installers use it directly so
# a VPS install doesn't need Node/pnpm/registry access. Rebuild + commit it
# (cd frontend && pnpm build) whenever frontend source changes.
# The negations below re-include frontend/dist which is excluded by 'dist/'
# above (and by 'dist' in frontend/.gitignore — that rule is overridden by
# the comment + negation in frontend/.gitignore itself).
!frontend/dist/
!frontend/dist/**

# IDE
.devin/
.vscode/
.idea/
*.swp
*.swo
windsurf/

# Database
instance/
*.db
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Environment & secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test/coverage
.coverage
htmlcov/
.pytest_cache/
frontend/coverage/

# Build artifacts
*.zip
*.tar.gz

# AGENTS.md (AI assistant context, not for repo)
AGENTS.md

# Reference-only production backups dropped in for comparison — never part
# of the repo itself
/backup-nms-*/