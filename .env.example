# Salfanet NMS — Environment Configuration
# Copy this file to .env and update values for your environment.

# --- Core ---
SECRET_KEY=change-me-to-a-random-secret-key
# Separate key for encrypting credentials (CLI passwords, ACS passwords).
# If not set, falls back to SECRET_KEY for backward compatibility.
CREDENTIAL_ENCRYPTION_KEY=
# Shared secret for Flask→FastAPI internal communication (WebSocket auth, /broadcast).
# MUST be explicitly set in production (FLASK_ENV=production). No fallback to SECRET_KEY.
# In development, a random ephemeral key is generated if not set.
INTERNAL_API_KEY=
FLASK_ENV=development
FLASK_DEBUG=0

# --- Database ---
# Leave empty for SQLite (default), or set PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/salfanet_nms
DATABASE_URL=

# --- Server ---
HOST=0.0.0.0
PORT=5000
WS_PORT=8765
# WebSocket/FastAPI bind host. Production: 127.0.0.1 (Nginx reverse proxy only).
# Development: 0.0.0.0 (direct access). Default: same as HOST.
# Firewall: block port 8765 from WAN, allow from Nginx/localhost only.
# WS_HOST=127.0.0.1

# --- CORS ---
# Comma-separated list of allowed origins. Production must use explicit origins.
# Example: https://nms.example.com,https://admin.example.com
# Wildcard * is never allowed (allow_credentials=True requires explicit origins).
# CORS_ALLOWED_ORIGINS=

# --- Session ---
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=https

# --- Redis (optional, for caching OLT data) ---
# REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Gateway (optional) ---
# WA_GATEWAY_URL=http://localhost:3001/send
